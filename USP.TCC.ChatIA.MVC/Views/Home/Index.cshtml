<div class="card card-warning card-outline direct-chat direct-chat-info">
    <div class="card-header">
        <h3 class="card-title" id="name"><i class="fas fa-robot"></i> Chat - Gestão de Projetos com IA</h3>

        <div class="card-tools">
            <span title="" id="posi" class="badge bg-dark">Beta </span>

        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <!-- Conversations are loaded here -->
        <div id="mssg" class="direct-chat-messages">
            <div class="direct-chat-msg">
                <div class="direct-chat-infos clearfix">
                    <span class="direct-chat-name float-left">ChatUSPIa</span>
                </div>
                <img class="direct-chat-img" src="~/img/logo_120.png" alt="Chat">
                <div class="direct-chat-text">Oi, como posso ajudar você hoje?  </div>
            </div>

        </div>

    </div>
    <!-- /.card-body -->
    <div class="card-footer">
        <form id="frm">
            <div class="input-group">
                <textarea id="txtMsg" rows="3" name="message" required="" style="overflow:hidden;resize:none" placeholder="Digite sua dúvida de Gestão de Projetos ..." class="form-control"></textarea>

                <span class="input-group-append">
                    <button type="button" id="send" class="btn btn-dark">Perguntar</button>
                </span>
            </div>
        </form>
    </div>
</div>


<script>
    function GerarSeek() {
        const min = 0.79;
        const max = 0.88;
        const numeroAleatorio = (Math.random() * (max - min) + min).toFixed(2);
        return numeroAleatorio; // Pode ser retornado como string ou convertido para número com parseFloat()
    }

    var chatbox = document.getElementById("mssg");
    var message = document.getElementById("txtMsg");
    var send = document.getElementById("send");

    send.addEventListener("click", function () {
        var userMessage = message.value;
        var userDiv = document.createElement("div");
        userDiv.className = "direct-chat-msg right";
        var corpoHtml = '<div class="direct-chat-infos clearfix"><span class="direct-chat-name float-right">Você</span></div><img class="direct-chat-img" src="/img/avatar.png" alt="Sua foto">';
        userDiv.innerHTML = corpoHtml + '<div class="direct-chat-text">' + userMessage + '</div>';
        chatbox.appendChild(userDiv);

        // Defina o JSON a ser enviado no corpo da solicitação POST
        var data = {
            Pergunta: userMessage,
            Options: {
                Temperature: 0.7
            }
        };
        message.value = "";
        fetch("api/chat/pergunta/", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        })
            .then(function (response) {

                return response.text();
            })
            .then(function (botMessage
            ) {
                var txt = JSON.parse(botMessage);
                console.log(txt);
                var botDiv = document.createElement("div");

                var corpoHtml = '<div class="direct-chat-infos clearfix"><span class="direct-chat-name float-left">ChatUSPIa</span></div><img class="direct-chat-img" src="/img/logo_120.png" alt="Chat">';
                    botDiv.className = "direct-chat-msg";
                botDiv.innerHTML = corpoHtml + '<div class="direct-chat-text"> [tokens: ' + txt.totalTokens + '] ' + txt.resposta.replace(/\n/g, '<br>') + ' </div></div>';
                chatbox.appendChild(botDiv);

                chatbox.scrollTop = chatbox.scrollHeight;
            });
    });
</script>